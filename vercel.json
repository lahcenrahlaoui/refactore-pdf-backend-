
{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "node_modules/@sparticuz/chromium/bin/**",
        "maxLambdaSize": "250mb"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/index.js" }
  ],
  "functions": {
    "index.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}