{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "node_modules/@sparticuz/chromium/bin/**",
          "fonts/**"
        ],
        "maxLambdaSize": "250mb",
        "memory": 1024,
        "maxDuration": 60
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/index.js" }
  ]
}